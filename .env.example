PORT=3001
SESSION_SECRET=replace-with-a-long-random-secret
THREADBOUND_DB_PATH=./data/threadbound.sqlite

# Authentication mode: threaded (default) or local.
# Use local for standalone development/testing without running Threaded.
# Local mode is rejected when NODE_ENV=production.
THREADBOUND_AUTH_MODE=threaded

# Required only when THREADBOUND_AUTH_MODE=threaded.
THREADED_BASE_URL=http://127.0.0.1:8000
THREADED_CLIENT_ID=threadbound-local
THREADED_REDIRECT_URI=http://127.0.0.1:3001/oauth/callback
