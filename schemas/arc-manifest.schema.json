{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadbound.local/schemas/arc-manifest.schema.json",
  "title": "Threadbound Arc Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestVersion", "arc", "lore", "enemies", "bosses", "dungeons", "itemPools", "achievements", "historicalConsequences"],
  "properties": {
    "manifestVersion": { "const": 1 },
    "arc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "premise", "progression"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/nonEmpty" },
        "premise": { "$ref": "#/$defs/nonEmpty" },
        "progression": {
          "type": "object",
          "additionalProperties": false,
          "required": ["metric", "target"],
          "properties": {
            "metric": { "enum": ["dungeon_clears", "boss_kills", "enemy_kills"] },
            "target": { "type": "integer", "minimum": 1, "maximum": 100000000 }
          }
        }
      }
    },
    "lore": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/loreEntry" } },
    "enemies": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/enemy" } },
    "bosses": { "type": "array", "maxItems": 30, "items": { "$ref": "#/$defs/boss" } },
    "runEvents": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/runEvent" } },
    "dungeons": { "type": "array", "minItems": 1, "maxItems": 30, "items": { "$ref": "#/$defs/dungeon" } },
    "itemPools": { "type": "array", "maxItems": 30, "items": { "$ref": "#/$defs/itemPool" } },
    "achievements": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/achievement" } },
    "historicalConsequences": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/history" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$" },
    "visualAssetId": { "type": "string", "pattern": "^(mob|boss|item)\\.[a-z0-9][a-z0-9-]*\\.v[1-9][0-9]*$", "maxLength": 120 },
    "nonEmpty": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "tags": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
    "loreEntry": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "summary", "body"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "title": { "$ref": "#/$defs/nonEmpty" },
        "summary": { "$ref": "#/$defs/nonEmpty" }, "body": { "$ref": "#/$defs/nonEmpty" },
        "tags": { "$ref": "#/$defs/tags" }
      }
    },
    "enemy": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "baseHp", "retaliation", "abilities"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "name": { "$ref": "#/$defs/nonEmpty" },
        "baseHp": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "retaliation": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "abilities": { "type": "array", "maxItems": 8, "uniqueItems": true, "items": { "type": "string" } },
        "intentCadence": { "type": "integer", "minimum": 1, "maximum": 6 },
        "visualAssetId": { "$ref": "#/$defs/visualAssetId" }
      }
    },
    "boss": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "baseHp", "retaliation", "abilities"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "name": { "$ref": "#/$defs/nonEmpty" },
        "baseHp": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "retaliation": { "type": "integer", "minimum": 0, "maximum": 5000 },
        "abilities": { "type": "array", "maxItems": 12, "uniqueItems": true, "items": { "type": "string" } },
        "intentCadence": { "type": "integer", "minimum": 1, "maximum": 6 },
        "visualAssetId": { "$ref": "#/$defs/visualAssetId" }
      }
    },
    "runEventEffects": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "healAll": { "type": "integer", "minimum": 0, "maximum": 40 },
        "damageAll": { "type": "integer", "minimum": 0, "maximum": 30 },
        "focusAll": { "type": "integer", "minimum": -4, "maximum": 4 },
        "runAttackBonus": { "type": "integer", "minimum": 0, "maximum": 5 }
      }
    },
    "runEventChoice": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "summary", "effects"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/nonEmpty" },
        "summary": { "$ref": "#/$defs/nonEmpty" },
        "effects": { "$ref": "#/$defs/runEventEffects" }
      }
    },
    "runEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "prompt", "choices"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/nonEmpty" },
        "prompt": { "$ref": "#/$defs/nonEmpty" },
        "choices": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "$ref": "#/$defs/runEventChoice" } }
      }
    },
    "runEventSchedule": {
      "type": "object", "additionalProperties": false,
      "required": ["afterEncounterIndex", "eventIds"],
      "properties": {
        "afterEncounterIndex": { "type": "integer", "minimum": 0, "maximum": 10 },
        "eventIds": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "encounterSequence": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/$defs/id" } },
    "dungeon": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "recommendedPlayers", "encounters", "bossId", "rewardPoolId"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "name": { "$ref": "#/$defs/nonEmpty" },
        "recommendedPlayers": { "type": "integer", "minimum": 1, "maximum": 4 },
        "encounters": { "$ref": "#/$defs/encounterSequence" },
        "encounterVariants": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/encounterSequence" } },
        "runEventSchedule": { "$ref": "#/$defs/runEventSchedule" },
        "bossId": { "$ref": "#/$defs/id" }, "rewardPoolId": { "$ref": "#/$defs/id" }
      }
    },
    "itemTemplate": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "namePattern", "rarity", "attackBonus", "effects"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "namePattern": { "$ref": "#/$defs/nonEmpty" },
        "rarity": { "enum": ["common", "uncommon", "rare", "epic", "legendary"] },
        "attackBonus": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "effects": { "type": "array", "maxItems": 6, "uniqueItems": true, "items": { "type": "string" } },
        "visualAssetId": { "$ref": "#/$defs/visualAssetId" }
      }
    },
    "itemPool": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "items"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "items": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/itemTemplate" } } }
    },
    "achievement": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "description", "event", "threshold"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "title": { "$ref": "#/$defs/nonEmpty" }, "description": { "$ref": "#/$defs/nonEmpty" },
        "event": { "enum": ["enemy_defeated", "boss_defeated", "dungeon_completed", "item_generated", "player_revived"] },
        "targetId": { "$ref": "#/$defs/id" },
        "threshold": { "type": "integer", "minimum": 1, "maximum": 100000000 }
      }
    },
    "history": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "trigger", "title", "body"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "trigger": { "enum": ["arc_started", "arc_completed", "threshold_reached"] },
        "title": { "$ref": "#/$defs/nonEmpty" }, "body": { "$ref": "#/$defs/nonEmpty" }
      }
    }
  }
}
